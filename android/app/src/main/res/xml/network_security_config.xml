<?xml version="1.0" encoding="utf-8"?>
<!-- Sin tráfico en claro (http): todo va por https. Solo se confía en las autoridades del sistema. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
