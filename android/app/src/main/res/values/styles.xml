<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base oscuro (la app es siempre oscura) -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/redline_bg</item>
        <item name="android:navigationBarColor">@color/redline_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/redline_bg</item>
        <item name="android:navigationBarColor">@color/redline_bg</item>
    </style>

    <!-- Arranque del sistema: fondo oscuro liso + la "C" de anillos (sin recuadro ni fondo de icono).
         Android 12+ lo dibuja el sistema (ver values-v31); Android 11 y menos, el tema compatible de androidx. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>